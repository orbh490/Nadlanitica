# כל משתני הסביבה של נדלניטיקה, בלי ערכים אמיתיים.
# האפליקציה לא קוראת את הקובץ הזה בעצמה: מגדירים את המשתנים במערכת ההפעלה (מקומית) או במסך Environment של Render.
# אם מעתיקים לקובץ .env מקומי - הוא מוחרג מגיט, ואסור להעלות אותו.

# ---- הרצה ----
# production = מסד PostgreSQL (חובה באתר החי). בלי - H2 בקובץ מקומי ב-./data
SPRING_PROFILES_ACTIVE=
# Render קובע לבד. ברירת מחדל: 8080
PORT=

# ---- מסד נתונים (רק בפרופיל production) ----
PG_HOST=ep-xxxx.eu-central-1.aws.neon.tech
PG_PORT=5432
PG_DATABASE=nadlanitica
PG_USER=
PG_PASSWORD=

# ---- מיילים ----
# ברירת מחדל: smtp.gmail.com:587. עם Brevo: smtp-relay.brevo.com
MAIL_HOST=
MAIL_PORT=
# בג'ימייל: כתובת התיבה, והסיסמה היא "סיסמת אפליקציה" (לא הסיסמה הרגילה)
MAIL_USERNAME=nadlanitica@gmail.com
MAIL_PASSWORD=
# ברירת מחדל לשלושתם: nadlanitica@gmail.com
MAIL_FROM=
CONTACT_EMAIL=
ALERTS_TO=

# ---- אתר ----
# מפתח לעמוד הלידים (/leads.html). ריק = העמוד חסום לגמרי
ADMIN_KEY=
# הכתובת הציבורית, בלי / בסוף - לקישורים במיילים ול-sitemap
BASE_URL=http://localhost:8080
